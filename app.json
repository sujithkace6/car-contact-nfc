{
  "expo": {
    "name": "car-contact-nfc",
    "slug": "car-contact-nfc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "carcontactnfc",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.jetconwoy.carcontactnfc",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app uses your location to mark and show parking spots on the map."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.NFC",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.jetconwoy.carcontactnfc",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAabczM3f-u16TEyQnDx9QomRVBbmry394"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "This app uses NFC to verify your vehicle's tag."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
